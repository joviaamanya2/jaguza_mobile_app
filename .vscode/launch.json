{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "jaguza_mobile_app (Local API)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--dart-define=USE_LOCAL_API=true",
                "--dart-define=LOCAL_API_BASE_URL=http://192.168.2.160:8000/api/v1/",
                "--dart-define=LOCAL_TOKEN_URL=http://192.168.2.160:8000/api/token/"
            ]
        },
        {
            "name": "jaguza_mobile_app (Production API)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--dart-define=USE_LOCAL_API=false"
            ]
        }
    ]
}
